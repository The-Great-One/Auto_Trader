# Auto_Trader retained paper-pipeline settings.
# Copy to .env only when overriding defaults; never commit real secrets.

# Paper ledger
RSI_LEDGER_CAPITAL=200000
RSI_LEDGER_COST_BPS=10
RSI_LEDGER_HIST_DIR=intermediary_files/Hist_Data
RSI_LEDGER_LIVE_MAX_AGE_SEC=600
RSI_LEDGER_MIN_PICKS=8
RSI_LEDGER_MIN_ROWS=350
RSI_LEDGER_ST_EXIT_MULT=0
RSI_LEDGER_TELEGRAM_ALERTS=0
AT_TEST_TRADER_CHANNEL=

# Paper shadow data quality
RSI_MOM_HIST_DIR=intermediary_files/Hist_Data
RSI_MOM_MIN_END_DATE=2026-04-17
RSI_MOM_MIN_ROWS=700

# Rotation/report support
AT_RSI_ROTATION_COST_BPS=10
AT_RSI_ROTATION_FFILL_LIMIT=3
AT_RSI_ROTATION_HIST_DIR=intermediary_files/Hist_Data
AT_RSI_ROTATION_MAX_SYMBOLS=0
AT_RSI_ROTATION_MIN_END_DATE=2026-04-17
AT_RSI_ROTATION_MIN_ROWS=700
AT_RSI_ROTATION_REBALANCE=ME,W-FRI
AT_RSI_ROTATION_REGIME=none,universe_sma100,universe_sma200
AT_RSI_ROTATION_SYMBOLS=
AT_RSI_ROTATION_TOP_N=10,20,30

# Trader_Labs qlib tracker import isolation
AT_RESEARCH_MODE=1
AT_DISABLE_FILE_LOGGING=1
AT_STATE_DIR=reports/qlib_rs_tracker_state
